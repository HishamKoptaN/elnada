<?xml version="1.0" encoding="utf-8"?>
<AppInstaller
    xmlns="http://schemas.microsoft.com/appx/appinstaller/2018"
    Version="3.0.0+3"
    Uri="https://raw.githubusercontent.com/HishamKoptaN/elnada/dev/abujena.appinstaller">
  <MainPackage
      Name="com.hishamkoptan.abujena"
      Publisher="CN=AbuJenaDawajen, O=AbuJenaDawajen, C=EG"
      Version="3.0.0+3"
      Uri="https://github.com/HishamKoptaN/elnada/releases/      download/desktop_msix/abujena_dawajen_dev.msix"
      ProcessorArchitecture="x64"/>
  <UpdateSettings>
    <OnLaunch HoursBetweenUpdateChecks="0" />
    <AutomaticBackgroundTask />
    <ShowPrompt>false</ShowPrompt>
    <ForceUpdateFromAnyVersion>false</ForceUpdateFromAnyVersion>
  </UpdateSettings>
</AppInstaller>
